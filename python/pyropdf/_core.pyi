# Type stubs for the extension module that crates/pyropdf-python builds.

from os import PathLike
from typing import Any, final

__version__: str

class PdfError(Exception): ...
class MalformedPdfError(PdfError): ...
class PasswordError(PdfError): ...
class EncryptedDocumentError(PdfError): ...

class LimitError(PdfError):
    @property
    def code(self) -> str: ...

class StaleObjectError(PdfError): ...
class DocumentClosedError(PdfError): ...

@final
class _Document:
    @staticmethod
    def empty(limits: Any, /) -> _Document: ...  # noqa: ANN401 - a DocumentLimits, read by attribute.
    @staticmethod
    def open_path(path: str, limits: Any, /) -> _Document: ...  # noqa: ANN401
    @staticmethod
    def open_buffer(data: bytes | bytearray | memoryview, limits: Any, /) -> _Document: ...  # noqa: ANN401
    def is_repaired(self) -> bool: ...
    def save_path(self, path: str, incremental: bool, /) -> None: ...
    def to_bytes(self, incremental: bool, max_size: int | None, /) -> bytes: ...
    def _objects(self) -> list[tuple[int, int, bytes]]: ...
    def close(self) -> None: ...

@final
class Pixmap:
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def channels(self) -> int: ...
    @property
    def alpha(self) -> bool: ...
    @property
    def stride(self) -> int: ...
    @property
    def resolution(self) -> tuple[int, int]: ...
    def to_bytes(self, format: str = "png", *, max_size: int | None = ...) -> bytes: ...  # noqa: A002
    def save(self, path: str | PathLike[str], /, *, format: str | None = None) -> None: ...  # noqa: A002
    def __buffer__(self, flags: int, /) -> memoryview: ...

def render_page(
    document: _Document, number: int, generation: int, matrix: tuple[float, float, float, float], alpha: bool, /
) -> Pixmap: ...
def web_limits() -> dict[str, Any]: ...
def probe(
    path: str | None, data: bytes | bytearray | memoryview | None, max_file_size: int | None, /
) -> tuple[int, str, bool, bool, dict[str, str]]: ...
def page_count(document: _Document, /) -> int: ...
def page_object(document: _Document, at: int, /) -> tuple[int, int]: ...
def page_index(document: _Document, number: int, generation: int, /) -> int | None: ...
def page_objects(document: _Document, /) -> list[tuple[int, int]]: ...
def page_geometry(document: _Document, number: int, generation: int, /) -> tuple[int, float, float] | None: ...
def set_page_rotation(document: _Document, number: int, generation: int, rotation: int, /) -> bool: ...
def set_pages(document: _Document, pages: list[tuple[int, int]], /) -> None: ...
def new_page(document: _Document, at: int, width: float, height: float, /) -> tuple[int, int]: ...
