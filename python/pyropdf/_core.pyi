# Type stubs for the extension module that crates/pyropdf-python builds.

from os import PathLike
from typing import Any, TypeAlias, final

__version__: str

class PdfError(Exception): ...
class MalformedPdfError(PdfError): ...
class PasswordError(PdfError): ...
class EncryptedDocumentError(PdfError): ...

class LimitError(PdfError):
    @property
    def code(self) -> str: ...

class StaleObjectError(PdfError): ...
class DocumentClosedError(PdfError): ...

@final
class CancellationToken:
    def __init__(self) -> None: ...
    def cancel(self) -> None: ...
    @property
    def cancelled(self) -> bool: ...

@final
class _Document:
    @staticmethod
    def empty(limits: object, /) -> _Document: ...
    @staticmethod
    def open_path(path: str, limits: object, password: bytes | None = None, /) -> _Document: ...
    @staticmethod
    def open_buffer(
        data: bytes | bytearray | memoryview, limits: object, password: bytes | None = None, /
    ) -> _Document: ...
    def is_repaired(self) -> bool: ...
    def save_path(self, path: str, incremental: bool, encryption: object = None, /) -> None: ...
    def to_bytes(self, incremental: bool, max_size: int | None, encryption: object = None, /) -> bytes: ...
    def _objects(self) -> list[tuple[int, int, bytes]]: ...
    def close(self) -> None: ...

@final
class Pixmap:
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def channels(self) -> int: ...
    @property
    def alpha(self) -> bool: ...
    @property
    def stride(self) -> int: ...
    @property
    def resolution(self) -> tuple[int, int]: ...
    def to_bytes(self, format: str = "png", *, max_size: int | None = ...) -> bytes: ...  # noqa: A002
    def save(self, path: str | PathLike[str], /, *, format: str | None = None) -> None: ...  # noqa: A002
    def __buffer__(self, flags: int, /) -> memoryview: ...

