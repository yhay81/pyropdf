# Type stubs for the extension module that crates/pyropdf-python builds.

from typing import Any, final

__version__: str

class PdfError(Exception): ...
class MalformedPdfError(PdfError): ...
class PasswordError(PdfError): ...
class EncryptedDocumentError(PdfError): ...

class LimitError(PdfError):
    @property
    def code(self) -> str: ...

class StaleObjectError(PdfError): ...
class DocumentClosedError(PdfError): ...

@final
class _Document:
    @staticmethod
    def empty(limits: Any, /) -> _Document: ...  # noqa: ANN401 - a DocumentLimits, read by attribute.
    @staticmethod
    def open_path(path: str, limits: Any, /) -> _Document: ...  # noqa: ANN401
    @staticmethod
    def open_buffer(data: bytes | bytearray | memoryview, limits: Any, /) -> _Document: ...  # noqa: ANN401
    def is_repaired(self) -> bool: ...
    def save_path(self, path: str, incremental: bool, /) -> None: ...
    def to_bytes(self, incremental: bool, max_size: int | None, /) -> bytes: ...
    def _objects(self) -> list[tuple[int, int, bytes]]: ...
    def close(self) -> None: ...

def web_limits() -> dict[str, Any]: ...
def probe(
    path: str | None, data: bytes | bytearray | memoryview | None, max_file_size: int | None, /
) -> tuple[int, str, bool, bool, dict[str, str]]: ...
