+def test_cancellation_after_sequential_raster_use() -> None:
+    token = pyropdf.CancellationToken()
+    with pyropdf.open(PDF, limits=pyropdf.DocumentLimits(cancellation=token)) as doc:
+        pages = [doc.pages[i] for i in range(3)]
+        for page in pages[:2]:
+            page.pixmap(dpi=72)
+        token.cancel()
+        with pytest.raises(pyropdf.LimitError) as refused:
+            pages[2].pixmap(dpi=72)
+        assert refused.value.code == "cancelled"
