+//! Document-owned native raster workers. Only the pool survives a page render.
+
+use hayro::vello_cpu::{Level, RenderContext, RenderSettings};
+
+fn level() -> Level {
+    Level::try_detect().unwrap_or(Level::baseline())
+}
+
+pub(super) fn serial(width: u16, height: u16) -> RenderContext {
+    RenderContext::new_with(
+        width,
+        height,
+        RenderSettings {
+            level: level(),
+            num_threads: 0,
+        },
+    )
+}
+
+/// Scratch-free worker ownership for a single open document.
+#[derive(Debug, Default)]
+pub struct RasterSession {
+    #[cfg(any(target_os = "linux", target_os = "macos", target_os = "windows"))]
+    native: native::Session,
+}
+
+impl RasterSession {
+    /// Close the idle pool and prevent an in-flight render from returning one.
+    pub fn close(&self) {
+        #[cfg(any(target_os = "linux", target_os = "macos", target_os = "windows"))]
+        self.native.close();
+    }
+
+    pub(super) fn render<T>(
+        &self,
+        width: u16,
+        height: u16,
+        index: usize,
+        pages: usize,
+        paint: impl FnOnce(&mut RenderContext) -> T,
+    ) -> T {
+        #[cfg(any(target_os = "linux", target_os = "macos", target_os = "windows"))]
+        if let Some(lease) = self.native.checkout(width, height, index, pages) {
+            let native::Lease { workers, permit } = lease;
+            let mut context = RenderContext::with_workers(width, height, level(), workers);
+            let result = paint(&mut context);
+            let workers = context
+                .into_workers()
+                .expect("context was constructed with workers");
+            self.native
+                .checkin(index, native::Lease { workers, permit });
+            return result;
+        }
+        #[cfg(not(any(target_os = "linux", target_os = "macos", target_os = "windows")))]
+        let _ = (index, pages);
+        paint(&mut serial(width, height))
+    }
+}
+
+#[cfg(any(target_os = "linux", target_os = "macos", target_os = "windows"))]
+mod native {
+    use hayro::vello_cpu::RasterWorkers;
+    use std::num::NonZeroU8;
+    use std::sync::atomic::{AtomicBool, Ordering};
+    use std::sync::{Mutex, PoisonError};
+
+    // One accelerated caller in the process. Other callers and batch workers
+    // can continue through the ordinary serial dispatcher without waiting.
+    static RESERVED: AtomicBool = AtomicBool::new(false);
+    #[derive(Debug)]
+    pub(super) struct Permit;
+    impl Drop for Permit {
+        fn drop(&mut self) {
+            RESERVED.store(false, Ordering::Release);
+        }
+    }
+
+    #[derive(Debug)]
+    pub(super) struct Lease {
+        // Drop the pool before advertising the permit.
+        pub(super) workers: RasterWorkers,
+        pub(super) permit: Permit,
+    }
+
+    impl Lease {
+        fn start(
+            count: NonZeroU8,
+            create: impl FnOnce(NonZeroU8) -> std::io::Result<RasterWorkers>,
+        ) -> Option<Self> {
+            RESERVED
+                .compare_exchange(false, true, Ordering::AcqRel, Ordering::Relaxed)
+                .ok()?;
+            let permit = Permit;
+            let workers = create(count).ok()?;
+            Some(Self { workers, permit })
+        }
+    }
+
+    #[derive(Debug, Default)]
+    struct Slot {
+        closed: bool,
+        next: Option<usize>,
+        idle: Option<Lease>,
+    }
+
+    #[derive(Debug, Default)]
+    pub(super) struct Session(Mutex<Slot>);
+
+    impl Session {
+        pub(super) fn close(&self) {
+            let mut slot = self.0.lock().unwrap_or_else(PoisonError::into_inner);
+            slot.closed = true;
+            let idle = slot.idle.take();
+            drop(slot);
+            drop(idle);
+        }
+
+        pub(super) fn checkout(
+            &self,
+            width: u16,
+            height: u16,
+            index: usize,
+            pages: usize,
+        ) -> Option<Lease> {
+            let pixels = u32::from(width) * u32::from(height);
+            let eligible = pages > 1 && (262_144..=4_194_304).contains(&pixels);
+            let mut slot = self.0.lock().unwrap_or_else(PoisonError::into_inner);
+            if slot.closed {
+                return None;
+            }
+            let sequential = slot.next == Some(index);
+            let last = index + 1 == pages;
+            slot.next = (eligible && !last).then_some(index + 1);
+            let idle = slot.idle.take();
+            drop(slot);
+            if !eligible || !sequential {
+                return None;
+            }
+            if idle.is_some() {
+                return idle;
+            }
+            if last {
+                return None;
+            }
+            let available = std::thread::available_parallelism().ok()?.get();
+            let count = NonZeroU8::new(available.saturating_sub(1).min(4) as u8)?;
+            Lease::start(count, RasterWorkers::new)
+        }
+
+        pub(super) fn checkin(&self, index: usize, lease: Lease) {
+            let mut slot = self.0.lock().unwrap_or_else(PoisonError::into_inner);
+            if !slot.closed && slot.next == Some(index + 1) {
+                slot.idle = Some(lease);
+            }
+        }
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+
+        #[test]
+        fn failed_start_and_concurrent_close_release_the_permit() {
+            let count = NonZeroU8::new(1).unwrap();
+            assert!(
+                Lease::start(count, |_| Err(std::io::Error::other(
+                    "thread startup failed"
+                )))
+                .is_none()
+            );
+            let running = Lease::start(count, RasterWorkers::new).unwrap();
+            assert!(
+                Lease::start(count, |_| panic!(
+                    "occupied permit must select serial rendering"
+                ))
+                .is_none()
+            );
+            let session = Session::default();
+            session.0.lock().unwrap().next = Some(2);
+            std::thread::scope(|s| {
+                s.spawn(|| session.close()).join().unwrap();
+            });
+            session.checkin(1, running);
+            let slot = session.0.lock().unwrap();
+            assert!(slot.closed && slot.idle.is_none());
+            assert!(Lease::start(count, RasterWorkers::new).is_some());
+        }
+    }
+}
