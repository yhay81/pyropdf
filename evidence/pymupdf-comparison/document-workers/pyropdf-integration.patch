+"""Raster workers share no graphics state across pages or document versions."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+import pyropdf
+
+PDF = Path(__file__).parent / "assets/real_world/bill-hr815.pdf"
