+def test_sequential_renders_after_a_refusal_and_a_page_edit() -> None:
+    with pyropdf.open(PDF) as doc, pyropdf.open(PDF) as oracle:
+        for page in doc.pages[:2]:
+            page.pixmap(dpi=72)
+        with pytest.raises(ValueError, match="exceeds the limit"):
+            doc.pages[2].pixmap(dpi=20_000)
+        doc.pages[2].obj["Rotate"] = 90
+        oracle.pages[2].obj["Rotate"] = 90
+        actual = doc.pages[2].pixmap(dpi=144, alpha=True)
+        expected = oracle.pages[2].pixmap(dpi=144, alpha=True)
+        assert (actual.width, actual.height, bytes(actual)) == (expected.width, expected.height, bytes(expected))
+
