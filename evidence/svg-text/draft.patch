diff --git c/src/text.rs i/src/text.rs
new file mode 100644
index 0000000..c7a2af4
--- /dev/null
+++ i/src/text.rs
@@ -0,0 +1,146 @@
+//! An invisible text layer, so that the text of a converted page can be
+//! selected, searched and copied while the glyphs stay paths.
+
+use crate::SvgRenderer;
+use crate::convert_transform;
+use hayro_interpret::font::GlyphRun;
+use hayro_interpret::hayro_cmap::BfString;
+use kurbo::{Affine, Point};
+
+/// The tolerance, in glyph units, below which a glyph is taken to sit on
+/// the baseline of the previous one.
+const BASELINE_TOLERANCE: f64 = 0.5;
+
+/// The advance assumed for the last glyph of a run, in glyph units, when
+/// it is needed to place the characters of a multi-character glyph.
+const DEFAULT_ADVANCE: f64 = 500.0;
+
+/// One `text` element of the layer: characters that share a transform.
+pub(crate) struct TextChunk {
+    transform: Affine,
+    text: String,
+    x: Vec<f32>,
+    y: Vec<f32>,
+}
+
+impl SvgRenderer<'_> {
+    /// Records the Unicode text of a glyph run, whatever its draw mode, for
+    /// the text layer. Glyphs without a Unicode mapping are left out.
+    pub(crate) fn record_text(&mut self, glyph_run: &GlyphRun<'_, '_>, transform: Affine) {
+        let glyphs = glyph_run.glyphs();
+        let mut chunk: Option<TextChunk> = None;
+
+        for (index, glyph) in glyphs.iter().enumerate() {
+            let Some(unicode) = glyph.as_unicode() else {
+                continue;
+            };
+            let text = match unicode {
+                BfString::Char(c) => c.to_string(),
+                BfString::String(s) => s,
+            };
+            // SVG text is drawn y-down, glyph space is y-up.
+            let base = transform * glyph.transform() * Affine::scale_non_uniform(1.0, -1.0);
+
+            let same_basis = chunk.as_ref().is_some_and(|c| {
+                let relative = (c.transform.inverse() * base).as_coeffs();
+                (relative[0] - 1.0).abs() < 1e-3
+                    && relative[1].abs() < 1e-3
+                    && relative[2].abs() < 1e-3
+                    && (relative[3] - 1.0).abs() < 1e-3
+            });
+            if !same_basis {
+                self.text_layer.extend(chunk.take());
+                chunk = Some(TextChunk {
+                    transform: base,
+                    text: String::new(),
+                    x: Vec::new(),
+                    y: Vec::new(),
+                });
+            }
+            let chunk = chunk.as_mut().unwrap();
+            let origin = chunk.transform.inverse() * base * Point::ORIGIN;
+            // Characters after the first of a multi-character glyph (a
+            // ligature, say) are spread up to the next glyph's origin.
+            let next = glyphs
+                .get(index + 1)
+                .map(|n| {
+                    chunk.transform.inverse()
+                        * transform
+                        * n.transform()
+                        * Affine::scale_non_uniform(1.0, -1.0)
+                        * Point::ORIGIN
+                })
+                .unwrap_or(origin + (DEFAULT_ADVANCE, 0.0));
+
+            let chars: Vec<char> = text.chars().filter(|c| is_xml_char(*c)).collect();
+            let count = chars.len();
+            for (at, c) in chars.into_iter().enumerate() {
+                let t = at as f64 / count as f64;
+                let p = origin.lerp(next, t);
+                chunk.text.push(if c.is_whitespace() { ' ' } else { c });
+                chunk.x.push(round(p.x));
+                chunk.y.push(round(p.y));
+            }
+        }
+
+        self.text_layer.extend(chunk.take());
+    }
+
+    /// Writes the text layer above everything that the page painted.
+    pub(crate) fn write_text_layer(&mut self) {
+        if self.text_layer.is_empty() {
+            return;
+        }
+
+        self.xml.start_element("g");
+        self.xml.write_attribute("id", "text-layer");
+        self.xml.write_attribute("fill-opacity", "0");
+        self.xml.write_attribute("xml:space", "preserve");
+
+        for chunk in std::mem::take(&mut self.text_layer) {
+            if chunk.text.is_empty() {
+                continue;
+            }
+            self.xml.start_element("text");
+            self.xml.write_attribute_fmt(
+                "transform",
+                format_args!("matrix({})", convert_transform(&chunk.transform)),
+            );
+            self.xml.write_attribute("font-size", "1000");
+            self.xml.write_attribute("x", &join(&chunk.x));
+            if chunk.y.iter().any(|y| y.abs() > BASELINE_TOLERANCE as f32) {
+                self.xml.write_attribute("y", &join(&chunk.y));
+            }
+            // Indentation would add whitespace to the text.
+            self.xml.set_preserve_whitespaces(true);
+            // `write_text` escapes `<` only.
+            let text = chunk.text.replace('&', "&amp;").replace('>', "&gt;");
+            self.xml.write_text(&text);
+            self.xml.end_element();
+            self.xml.set_preserve_whitespaces(false);
+        }
+
+        self.xml.end_element();
+    }
+}
+
+fn round(value: f64) -> f32 {
+    ((value * 10.0).round() / 10.0) as f32
+}
+
+fn join(values: &[f32]) -> String {
+    let mut out = String::with_capacity(values.len() * 6);
+    for (at, value) in values.iter().enumerate() {
+        if at > 0 {
+            out.push(' ');
+        }
+        out.push_str(&value.to_string());
+    }
+    out
+}
+
+/// Whether XML 1.0 allows the character in text.
+fn is_xml_char(c: char) -> bool {
+    matches!(c, '\u{9}' | '\u{A}' | '\u{D}' | '\u{20}'..='\u{D7FF}' | '\u{E000}'..='\u{FFFD}')
+        || c >= '\u{10000}'
+}
