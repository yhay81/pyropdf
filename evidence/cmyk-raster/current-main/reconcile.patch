+fn mesh_source_interpolation() {
+    let pixmap = render("pdfs/custom/cmyk_mesh_source_interpolation.pdf");
+    // The three RGB vertices carry no black individually, but their neutral
+    // centre has the same black generation as a flat one-third grey swatch.
+    // The five-spot triangle's fifth component maps to its square in black.
+    for (sample_x, swatch_x, black) in [(30, 105, 170), (150, 225, 28)] {
+        let [c, m, y, k, a] = pixel(&pixmap, sample_x, 60);
+        assert_eq!(pixel(&pixmap, swatch_x, 60), [0, 0, 0, black, 255]);
+        // The sampled pixel centre lies within half a point of the centroid.
+        assert!(c <= 2 && m <= 2 && y <= 2 && k.abs_diff(black) <= 2);
+        assert_eq!(a, 255);
+    }
+}
